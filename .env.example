# ==============================================================
# SkySafe Environment Variables Example (Do NOT commit real secrets)
# ==============================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Replace with your MongoDB connection string (Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/skysafe?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_strong_secret_key_here

# Flight Provider Configuration
# Options: "amadeus" (uses live Amadeus Test API) or "mock" (offline fallback)
FLIGHT_PROVIDER=amadeus

# Amadeus Self-Service API (Test Environment)
# Register at https://developers.amadeus.com to obtain free test credentials
AMADEUS_CLIENT_ID=your_amadeus_api_key
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret

# AI / NLP Configuration (Optional)
# If provided, Gemini LLM will be used as the primary semantic query parser.
# If omitted or offline, the robust built-in rule-based NLP parser seamlessly handles requests.
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration (for client/.env or client build)
# VITE_API_URL=http://localhost:5000/api
